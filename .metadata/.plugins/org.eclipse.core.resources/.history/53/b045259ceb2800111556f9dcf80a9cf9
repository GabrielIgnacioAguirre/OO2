package io.github.unlp_oo.archetype;

import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;

public class SistemaTest {
	private Sistema s = new Sistema();
	private Usuario user1 = new Usuario("A");;
	
	@Test
	void testChequearUsuarioExistente(){
		assertTrue(s.CrearUsuario(user1.getScreenName()));
		assertFalse(s.CrearUsuario(user1.getScreenName()));
	}
	
	@Test
	void testEliminarUsuario() {
		assertTrue(s.EliminarUsuario("A"));
		assertFalse(s.EliminarUsuario("A"));
	}
}
