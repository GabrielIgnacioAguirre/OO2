package io.github.unlp_oo.archetype;

import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;

public class UsuarioTest {
	private Usuario u = new Usuario("A");
	private String text1 = "Una publicacion 1";
	private String text2 = "Una publicacion 2";
	private ReTweet ret;
	
	@Test
	void testRepostearPublicacion() {
		System.out.println("----Inicio F1----");
		u.CrearPublicacion(text1);
		Tweet t = new Tweet(text2);
		u.RepostearPublicacion(t);
		assertEquals(2, u.getTweets().size());
		assertEquals(text2, u.getTweets().get(1));
		System.out.println("----Fin F1----");
	}
	
	@Test
	void testCrearPublicacion(){
		System.out.println("----Inicio F3----");
		assertEquals(0, u.getTweets().size());
		System.out.println(u.getTweets().size());
		u.CrearPublicacion(text1);
		assertEquals(1, u.getTweets().size());
		System.out.println(u.getTweets().size());
		u.CrearPublicacion(text2);
		assertEquals(2, u.getTweets().size());
		System.out.println(u.getTweets().size());
		System.out.println("----Fin F4----");
	}
}
