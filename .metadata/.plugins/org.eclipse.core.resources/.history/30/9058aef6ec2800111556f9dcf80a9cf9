package io.github.unlp_oo.archetype;

import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;

public class SistemaTest {
	private Sistema s1 = new Sistema();
	private Usuario user1 = new Usuario("A");
	private Sistema s2 = new Sistema();
	private Usuario user2 = new Usuario("A");
	
	
	@BeforeEach
	void setUp() {
		
		System.out.println("----Usuarios creados----");
	}
	@Test
	void testChequearUsuarioExistente(){
		assertTrue(s1.CrearUsuario(user1.getScreenName()));
		assertFalse(s1.CrearUsuario(user1.getScreenName()));
		System.out.println("Fin test 1");
	}
	
	@Test
	void testEliminarUsuario() {
		s2.CrearUsuario(user2.getScreenName());
		
		assertTrue(s2.EliminarUsuario("A"));
		assertFalse(s2.EliminarUsuario("A"));
		System.out.println("Fin test 2");
	}
}
