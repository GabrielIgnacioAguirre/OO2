package io.github.unlp_oo.archetype;
import java.util.ArrayList;

public class Usuario {
	private String screenName;
	private ArrayList<Publicacion> tweets;
	
	public Usuario(String screenname) {
		this.screenName = screenname;
		this.tweets = new ArrayList<Publicacion>();
	}
	
	public void CrearPublicacion(String text){
		Tweet t = new Tweet(text);
		this.tweets.add(t);
		System.out.print("Publicacion realizada");
	}
	
	public void RepostearPublicacion(Tweet tweet){
		ReTweet t = new ReTweet(tweet);
		this.tweets.add(t);
		System.out.print("Reposteo realizado");
	}
	
	
	//Setters y Getters
	
	public String getScreenName() {
		return screenName;
	}

	public ArrayList<Publicacion> getTweets() {
		return tweets;
	}

	public void setTweets(ArrayList<Publicacion> tweets) {
		this.tweets = tweets;
	}

	public void setScreenName(String screenName) {
		this.screenName = screenName;
	}
}
